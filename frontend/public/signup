<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: #111;
      background: #fff;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .container {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
    }

    .signup-box {
      border: 1px solid #ccc;
      padding: 30px;
      width: 100%;
      max-width: 400px;
      background: #fff;
      text-align: center;
    }

    .image-placeholder {
      width: 100px;
      height: 100px;
      border: 1px dashed #aaa;
      margin: 0 auto 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 12px;
      color: #555;
    }

    h1 {
      font-size: 22px;
      margin-bottom: 10px;
    }

    p.subtitle {
      font-size: 14px;
      color: #555;
      margin-bottom: 20px;
    }

    .social-buttons {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 15px;
    }

    .social-buttons button {
      flex: 1;
      padding: 10px;
      background: #fff;
      border: 1px solid #111;
      cursor: pointer;
      font-size: 14px;
    }

    .social-buttons button:hover {
      background: #f2f2f2;
    }

    .divider {
      margin: 15px 0;
      font-size: 12px;
      color: #999;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    input {
      padding: 10px;
      border: 1px solid #ccc;
      font-size: 14px;
    }

    .checkbox {
      display: flex;
      align-items: center;
      gap: 5px;
      margin: 10px 0;
      font-size: 12px;
    }

    .btn-primary {
      padding: 12px;
      margin-top: 10px;
      border: none;
      background: #111;
      color: #fff;
      cursor: pointer;
      font-size: 14px;
    }

    .btn-primary:hover {
      background: #333;
    }

    .footer-text {
      font-size: 12px;
      margin-top: 15px;
    }

    .footer-text a {
      color: #111;
      text-decoration: underline;
    }

    footer {
      border-top: 1px solid #ddd;
      padding: 15px 20px;
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: #555;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="signup-box">
      <div class="image-placeholder">[ Image Placeholder ]</div>

      <h1>Sign Up</h1>
      <p class="subtitle">It is necessary!</p>

      <div class="social-buttons">
        <button>Facebook</button>
        <button>Google</button>
      </div>

      <div class="divider">Or</div>

      <form>
        <input type="text" placeholder="Name">
        <input type="email" placeholder="Email/Phone Number">
        <input type="password" placeholder="Password">
        
        <div class="checkbox">
          <input type="checkbox" id="terms">
          <label for="terms">I agree to the Terms of Service and Privacy Policy</label>
        </div>

        <button type="submit" class="btn-primary">Create Account</button>
      </form>

      <p class="footer-text">
        Do you have an account? <a href="#">Sign In</a>
      </p>
    </div>
  </div>

  <footer>
    <p>© 2026 by ThoReSt</p>
    <p><a href="#">Privacy Policy</a></p>
  </footer>
</body>
</html>
